// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WalletType {
  BANK
  E_WALLET
  CASH
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum GoalFrequency {
  WEEKLY
  MONTHLY
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  wallets      Wallet[]
  transactions Transaction[]
  budgets      Budget[]
  goals        Goal[]
  settings     UserSettings?
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Wallet {
  id                String             @id @default(uuid())
  userId            String
  name              String
  type              WalletType         @default(BANK)
  institution       String?
  accountLast4      String?
  balance           Decimal            @default(0) @db.Decimal(15, 2)
  color             String?            @default("periwinkle")
  icon              String?            @default("Bank")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  goalContributions GoalContribution[]
  sourceGoals       Goal[]             @relation("GoalSourceWallet")
  destinationGoals  Goal[]             @relation("GoalDestinationWallet")

  @@index([userId])
  @@map("wallets")
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String
  walletId        String
  type            TransactionType
  amount          Decimal         @db.Decimal(15, 2)
  category        String
  description     String
  transactionDate DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet          Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@index([transactionDate])
  @@index([userId, transactionDate])
  @@map("transactions")
}

model Budget {
  id          String   @id @default(uuid())
  userId      String
  category    String
  limitAmount Decimal  @db.Decimal(15, 2)
  month       Int
  year        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month, year])
  @@index([userId, month, year])
  @@map("budgets")
}

model Goal {
  id                   String             @id @default(uuid())
  userId               String
  name                 String
  category             String
  targetAmount         Decimal            @db.Decimal(15, 2)
  currentAmount        Decimal            @default(0) @db.Decimal(15, 2)
  deadline             DateTime
  sourceWalletId       String?
  destinationWalletId  String?
  frequency            GoalFrequency      @default(MONTHLY)
  autoDeposit          Boolean            @default(false)
  nextDueDate          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceWallet         Wallet?            @relation("GoalSourceWallet", fields: [sourceWalletId], references: [id], onDelete: SetNull)
  destinationWallet    Wallet?            @relation("GoalDestinationWallet", fields: [destinationWalletId], references: [id], onDelete: SetNull)
  contributions        GoalContribution[]

  @@index([userId])
  @@index([sourceWalletId])
  @@index([destinationWalletId])
  @@map("goals")
}

model GoalContribution {
  id               String   @id @default(uuid())
  goalId           String
  sourceWalletId   String
  amount           Decimal  @db.Decimal(15, 2)
  contributionDate DateTime @default(now())
  createdAt        DateTime @default(now())

  goal             Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  sourceWallet     Wallet   @relation(fields: [sourceWalletId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([sourceWalletId])
  @@index([contributionDate])
  @@map("goal_contributions")
}

model UserSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique
  language             String   @default("id-ID")
  currency             String   @default("IDR")
  numberFormat         String   @default("id-ID")
  defaultWalletId      String?
  defaultCategory      String?
  budgetReminder       Boolean  @default(true)
  goalReminder         Boolean  @default(true)
  financialSummary     Boolean  @default(true)
  aiPersonalization    Boolean  @default(true)
  aiActionConfirmation Boolean  @default(true)
  animations           Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
