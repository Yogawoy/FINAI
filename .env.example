# Database connection string (PostgreSQL Cloud e.g. Neon, Supabase, Railway)
# For serverless (Vercel), pooled connection is recommended:
DATABASE_URL="postgresql://user:password@ep-xyz.neon.tech/finai?sslmode=require"

# Auth secret key (random 32+ characters string)
AUTH_SECRET="super-secret-auth-key-min-32-chars-long"

# Groq API Key for FinAI AI Assistant (from https://console.groq.com/keys)
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"

# Optional fallback xAI API Key
XAI_API_KEY=""
